{
  "expo": {
    "name": "حيّنا",
    "slug": "hayna",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hayna",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج حيّنا الوصول إلى صورك لاختيار صورة الملف الشخصي.",
          "cameraPermission": "يحتاج حيّنا الكاميرا لالتقاط صورة الملف الشخصي.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يحتاج حيّنا إلى موقعك لإظهار موقعك على الخريطة وتخصيص الحي."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.hayna.app",
      "icon": "./public/assets/branding/HAYNA_LOGO.png"
    },
    "android": {
      "package": "sa.hayna.app",
      "adaptiveIcon": {
        "foregroundImage": "./public/assets/branding/HAYNA_LOGO.png",
        "backgroundColor": "#065f46"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/assets/branding/HAYNA_LOGO.png"
    },
    "extra": {
      "eas": {
        "projectId": "5228885c-729d-4f4a-935d-06662dfd4beb"
      }
    },
    "icon": "./public/assets/branding/HAYNA_LOGO.png"
  }
}
